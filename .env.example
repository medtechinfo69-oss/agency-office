# ============================================================
# AGENCY OFFICE — environment configuration
# Copy to .env and fill in your values. NEVER commit .env.
# Tokens are read only by the backend: they are never sent
# to the frontend and never written to logs.
# ============================================================

# ---------------- AI provider selection --------------------
# Which provider handles calls: openrouter | apinex | groq | gemini | ollama
# (Settings → Providers can override this at runtime; kv value wins on restart)
ACTIVE_PROVIDER=openrouter

# Per-provider credentials — pattern: {KEY}_TOKEN / {KEY}_MODEL / {KEY}_BASE_URL
# Only the active provider's token is required; others feed the failover chain.

# OpenRouter (openrouter.ai/keys) — free models end with ":free"
OPENROUTER_TOKEN=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# APInex (apinex.bond) — free/* models
APINEX_TOKEN=
APINEX_MODEL=free/glm-5.3-flash
# APINEX_BASE_URL=https://api.apinex.bond/v1

# Groq free tier (console.groq.com/keys)
GROQ_TOKEN=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini free tier (aistudio.google.com/apikey)
GEMINI_TOKEN=
GEMINI_MODEL=gemini-2.5-flash

# Ollama local (ollama.com/download) — unlimited, no key needed
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Legacy single-provider vars (fallback if no ACTIVE_PROVIDER preset matches)
API_BASE_URL=
API_TOKEN=
TEXT_MODEL=

# Image generation (OpenAI-compatible images endpoint or preset name)
# Images are automatic: pollinations-free (keyless, free) is the default and
# needs no API key. Set to none to disable generation (SVG placeholders only).
IMAGE_MODEL=pollinations-free

# Demo mode is REMOVED from the app: false keeps everything on real APIs and
# surfaces clear errors (fix keys in Settings → Providers). true still exists
# only for offline unit tests.
DEMO_MODE=false

# Backend
HOST=0.0.0.0
PORT=8000
DB_PATH=data/agency.db

# Timeouts / retries for the provider layer
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=4

# Pricing used for the cost counter (USD per 1K tokens) — fallback only
# when the API does not report usage.cost (OpenRouter :free reports 0).
PRICE_INPUT_PER_1K=0.00015
PRICE_OUTPUT_PER_1K=0.0006

# Optional Meta Graph API (draft/approval-only publishing).
# Leave empty to keep Meta publishing disabled (local export still works).
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ID=

# Optional trend scan (DuckDuckGo HTML, no key required). Set to "knowledge"
# to let the model answer from its own knowledge when web access fails.
TREND_SEARCH=web

# ---------------- Hosted deployment only --------------------
# The Docker/Render setup sets APP_ENV=production and requires these values.
# Generate/store both secrets in the backend host dashboard, NOT in chat/Git.
# APP_ENV=production
# ACCESS_PASSWORD=  # at least 16 characters; Render generates a strong value
# SESSION_SECRET=   # at least 32 characters; Render generates a strong value
# ALLOWED_ORIGINS=  # exact HTTPS Vercel origin(s), comma-separated, no paths
# DATA_DIR=/data
# DB_PATH=/data/agency.db
# Frontend Vercel build setting (public URL, never a secret):
# VITE_WS_URL=wss://YOUR-PERSISTENT-BACKEND/ws

# Supabase staged integration (frontend/public values only).
# These do not replace the Python API; see SUPABASE_MIGRATION.md.
# For Vite local testing, set them in frontend/.env.local, not this root file.
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Never use a Supabase secret or service-role key in VITE_ variables.

# Vercel backend only: restricted Supabase pooler URL (never prefix VITE_)
# DATABASE_URL=postgresql://agency_backend.PROJECT:URL_ENCODED_PASSWORD@POOLER:6543/postgres?sslmode=verify-full&sslrootcert=system
# Vercel frontend only: replaces unsupported WebSockets with persisted polling
# VITE_EVENT_TRANSPORT=poll
